# --- app ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- database ---
DATABASE_URL=postgresql+psycopg://codementor:codementor@localhost:5432/codementor

# --- auth ---
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- llm ---
LLM_PROVIDER=nvidia            # nvidia | anthropic | openai
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TUTOR_API_KEYS=         # Comma-separated pool of 5 keys for Learning AI Teacher
NVIDIA_PRACTICE_API_KEYS=      # Comma-separated pool of 2 keys for Practice Portal
NVIDIA_API_KEY=                # Fallback primary key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_S=8.0
LLM_RETRY_TIMEOUT_S=4.0

# --- embeddings ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- rate limiting ---
SUBMISSION_RATE_LIMIT=10
SUBMISSION_RATE_WINDOW_S=300
