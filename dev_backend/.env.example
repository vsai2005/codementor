# Environment Variables Example for dev_backend

# Primary: NVIDIA Nemotron 3 Ultra (NIM)
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 5 Dedicated Keys for Learning / AI Teacher (auto-rotate on rate limit)
NVIDIA_TUTOR_API_KEYS=key1,key2,key3,key4,key5

# 2 Dedicated Keys for Practice Portal (Code Review, Debrief, Tutor)
NVIDIA_PRACTICE_API_KEYS=key1,key2

NVIDIA_API_KEY=key1

# Secondary Backups (optional)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest


# Allowed frontend origins for CORS (e.g. https://codementor.vercel.app)
ALLOWED_ORIGINS=

# JWT Auth Secret (generate with: openssl rand -hex 32)
AUTH_SECRET=

# Durable storage (Upstash Redis REST API, optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
