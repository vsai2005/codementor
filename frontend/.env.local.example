# Backend URL for Next.js same-origin proxy (/api/* -> BACKEND_URL/api/*)
# Production must use this proxy (leave NEXT_PUBLIC_API_BASE_URL unset) so the backend can
# rate-limit by real client IP.
BACKEND_URL=http://localhost:8000

# (Optional) Direct browser API override. Leave unset to use same-origin proxy.
# NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-only (never NEXT_PUBLIC_). Set ONLY in the Vercel project, with the same value as the
# backend's PROXY_SHARED_SECRET. middleware.ts uses it to attest the client IP that Vercel
# writes. Leave unset locally: outside Vercel the forwarding headers are client-controlled.
# PROXY_SHARED_SECRET=
